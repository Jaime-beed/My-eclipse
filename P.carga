' Initialize / Created
'========================
Public Sub Initialize As Object
	
	  ' <- inicializa ANTES de agregar
	listaClientes.Initialize
	listaFiltrada.Initialize
	
	
	Return Me
End Sub


Private Sub B4XPage_Created (Root1 As B4XView)
	Root = Root1
	Root.LoadLayout("Guardar")

	Ver_Pago_obj.Initialize
	B4XPages.AddPage("Ver_Pago", Ver_Pago_obj)
	
	Pagos_obj.Initialize
	B4XPages.AddPage("Pagos",Pagos_obj)

	interui
	Sleep(1000)
	CrearUI
	
	CargarClientes
	
	
End Sub





